# Copy this file to .env and add the values from your Salesforce External Client App.
SF_CLIENT_ID=
SF_CLIENT_SECRET=
# https://login.salesforce.com for Developer Edition, or https://test.salesforce.com for a sandbox
SF_LOGIN_URL=https://login.salesforce.com
SF_REDIRECT_URI=https://cloudvandana-salesforce-crud.vercel.app/auth/callback
SESSION_SECRET=replace-with-a-long-random-string
PORT=3000
# In production, set this to the deployed origin only (without /auth/callback).
# Set SF_REDIRECT_URI to the deployed origin followed by /auth/callback.
APP_URL=https://cloudvandana-salesforce-crud.vercel.app
